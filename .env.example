# Copy this file to .env. Never commit .env or put API keys in browser code.
# Set a provider's API_KEY + MODEL_NAME + MODEL_VERSION, then restart the server.
# MODEL_NAME must be an API model identifier enabled for your account.
# MODEL_VERSION should record the actual snapshot/revision; an alias is not an immutable revision.
# Optional for any provider: TEMPERATURE=omit (default) or supported numeric value.
# JSON_MODE=false omits response_format for models that reject JSON mode;
# response content is still strictly validated JSON. Default JSON_MODE=true.
TOXILENS_DEFAULT_PROVIDER=custom

# OpenAI / ChatGPT: default https://api.openai.com/v1/chat/completions
TOXILENS_OPENAI_API_KEY=
TOXILENS_OPENAI_MODEL_NAME=
TOXILENS_OPENAI_MODEL_VERSION=
TOXILENS_OPENAI_SEND_IMAGE=false

# DeepSeek: default https://api.deepseek.com/chat/completions
# Enable images only if the chosen API model actually supports vision.
TOXILENS_DEEPSEEK_API_KEY=
TOXILENS_DEEPSEEK_MODEL_NAME=
TOXILENS_DEEPSEEK_MODEL_VERSION=
TOXILENS_DEEPSEEK_SEND_IMAGE=false

# Qwen / 千问: default DashScope China OpenAI-compatible endpoint.
# Override API_URL for the provider region used by your account.
TOXILENS_QWEN_API_KEY=
TOXILENS_QWEN_MODEL_NAME=
TOXILENS_QWEN_MODEL_VERSION=
TOXILENS_QWEN_SEND_IMAGE=false

# GLM / 智谱: default https://open.bigmodel.cn/api/paas/v4/chat/completions
TOXILENS_GLM_API_KEY=
TOXILENS_GLM_MODEL_NAME=
TOXILENS_GLM_MODEL_VERSION=
TOXILENS_GLM_SEND_IMAGE=false

# Custom HTTP prediction service, e.g. your deployed TxGemma-Predict service.
# API_FORMAT=json uses the explicit ToxiLens prediction contract.
# API_FORMAT=openai uses structured chat completion, always uncalibrated_score.
TOXILENS_CUSTOM_API_URL=
TOXILENS_CUSTOM_API_KEY=
TOXILENS_CUSTOM_MODEL_NAME=
TOXILENS_CUSTOM_MODEL_VERSION=
TOXILENS_CUSTOM_API_FORMAT=json
TOXILENS_CUSTOM_SCORE_KIND=uncalibrated_score
TOXILENS_CUSTOM_SEND_IMAGE=false
TOXILENS_CUSTOM_TIMEOUT_SECONDS=30

# Independent research Compare. Disabled until audited real B16 files exist.
TOXNET_MULTITASK_ENABLE=false
TOXNET_MULTITASK_MODEL_DIR=
TOXNET_MULTITASK_ENCODER_DIR=
TOXNET_MULTITASK_DEVICE=cpu
# Optional isolated worker Python; defaults to the server's interpreter.
TOXNET_COMPARE_PYTHON=
TOXNET_OLLAMA_URL=http://127.0.0.1:11434
TOXNET_OLLAMA_MODEL=qwen3.5:4b
# Explicit room for the immutable facts and full structured report; not a VRAM claim.
TOXNET_OLLAMA_CONTEXT_TOKENS=8192
TOXNET_OLLAMA_OUTPUT_TOKENS=4096
TOXNET_COMPARE_MAX_RUNNING=1
# Optional driver sampling, entire board incl. desktop; not per-model allocation.
TOXNET_COMPARE_GPU_SAMPLING=false
TOXNET_COMPARE_MAX_RUNS=32
TOXNET_COMPARE_STAGE_TIMEOUT_SECONDS=240
TOXNET_COMPARE_RUN_TIMEOUT_SECONDS=900
TOXNET_COMPARE_TTL_SECONDS=1800
# No downloads or license acceptance happen automatically.
AIDD_TXGEMMA_ENABLE=false
AIDD_TXGEMMA_LICENSE_ACCEPTED=false
AIDD_TXGEMMA_SNAPSHOT_DIR=
AIDD_TXGEMMA_AUDIT_RECEIPT=
# Keep original transformers path unless the user selects the audited GGUF runtime.
AIDD_TXGEMMA_RUNTIME=transformers
AIDD_TXGEMMA_OLLAMA_MODEL=txgemma-2b:latest
# Exact /api/tags digest after local manifest and pinned GGUF source verification.
AIDD_TXGEMMA_OLLAMA_DIGEST=

# Scientific validation: CPU-only workers; never grant rights by this flag.
# Default protected LOCALAPPDATA location; optional operator-only root override.
TOXNET_VALIDATION_ROOT=
TOXNET_VALIDATION_ALLOW_LABELS=false
